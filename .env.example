# Template for the local .env file. Copy it and fill in real values:
#   cp .env.example .env
# .env is git-ignored. In deployed environments set these as real environment
# variables instead - they take precedence over the file.

# --- MySQL ---
DB_URL=jdbc:mysql://localhost:3306/devconnect
DB_USERNAME=root
DB_PASSWORD=your-mysql-password

# --- Gmail SMTP (use a Google app password, not your account password) ---
MAIL_USERNAME=your.address@gmail.com
MAIL_PASSWORD=your-16-character-app-password

# --- Redis (local or Upstash) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_SSL=false

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- JWT signing key: random string, at least 32 characters ---
JWT_SECRET=replace-with-a-random-string-of-at-least-32-chars
