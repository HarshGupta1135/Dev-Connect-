# Template for the local .env file. Copy it and fill in real values:
#   cp .env.example .env
# .env is git-ignored. In deployed environments set these as real environment
# variables instead - they take precedence over the file.

# The MySQL and Redis values below assume the containers from docker-compose.yml:
#   docker compose up -d mysql redis
# They publish on 3307 and 6380 rather than the default ports, so the stack does not
# collide with a MySQL or Redis already installed on the machine.
#
# docker-compose.yml overrides these for the app container with service names, so this
# one file covers both ways of running: `mvnw spring-boot:run` reaches the containers
# through the published ports, `docker compose up -d app` reaches them directly, and
# both read and write the same data.
#
# Pointing at a MySQL installed on the host instead is fine — use
# jdbc:mysql://localhost:3306/devconnect — but then decide which of the two is the
# real database, because both ways of running will not agree.

# --- MySQL ---
DB_URL=jdbc:mysql://localhost:3307/devconnect
DB_USERNAME=root
DB_PASSWORD=devconnect-local

# --- Gmail SMTP (use a Google app password, not your account password) ---
MAIL_USERNAME=your.address@gmail.com
MAIL_PASSWORD=your-16-character-app-password

# --- Redis: the compose container. For Upstash use its host, port 6379 and SSL true.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=devconnect-local
REDIS_SSL=false

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- JWT signing key: random string, at least 32 characters ---
JWT_SECRET=replace-with-a-random-string-of-at-least-32-chars
