# Leave unset for local development: requests go to the Vite dev server, which
# proxies /api, /admin and /health to http://localhost:8080 (see vite.config.js).
#
# Set this for a deployed frontend, pointing at the deployed backend origin.
# The backend must then allow that origin via CORS.
# VITE_API_BASE_URL=https://your-backend.example.com
